# Copy to `.env` and fill in real values. `.env` is git-ignored (DECISIONS.md
# §8c: credentials are read from environment/config at session start and never
# written to any log, artifact, or evidence file).

# Target surface (DECISIONS.md §1)
PARABANK_BASE_URL=http://localhost:8080/parabank

# LLM provider via the OpenAI SDK (DECISIONS.md §2d) — GLM, configurable
# base_url/api_key so a provider swap is a config change, not a rewrite.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=glm-5.2

# Discovery-loop guard rails (DECISIONS.md §3d)
BANKOPS_MAX_STEPS=40

# Evidence/terminal redaction (DECISIONS.md §8c) — implemented but OFF
# "for now" per operator preference so agent runs show real values;
# set true (or pass --redact) to mask credentials/sensitive data.
BANKOPS_REDACT=false
